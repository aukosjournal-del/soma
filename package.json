{
  "name": "soma-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOMA — App multiplateforme de suivi d'entraînement (React + Vite + TS, packaging natif Capacitor). Sprint 1 : Fondations, DDD & Identity.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "supabase gen types typescript --project-id ujanhmwreipxeypkpcoc --schema public > src/infrastructure/supabase/database.types.ts",
    "cap:sync": "cap sync",
    "cap:ios": "cap run ios",
    "cap:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/haptics": "^8.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.10"
  }
}
